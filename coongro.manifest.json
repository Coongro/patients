{
  "id": "patients",
  "version": "1.3.0",
  "apiVersion": "2.0",
  "assets": {
    "styles": [
      "./dist/assets/tailwind.css",
      "./dist/assets/fontawesome/css/all.min.css"
    ]
  },
  "contributes": {
    "menus": [
      {
        "path": "Pacientes",
        "order": 1,
        "color": "#10B981",
        "icon": "assets/icons/paw.svg"
      },
      {
        "path": "Pacientes/Mascotas",
        "order": 1,
        "viewId": "patients.list.open"
      },
      {
        "path": "Pacientes/Dueños",
        "order": 2,
        "viewId": "patients.owners.open"
      }
    ],
    "views": [
      {
        "id": "patients.list.open",
        "title": "Pacientes",
        "component": "./dist/views/patients-list/index.js",
        "export": "PatientsListView"
      },
      {
        "id": "patients.detail.open",
        "title": "Ficha Paciente",
        "component": "./dist/views/patient-detail/index.js",
        "export": "PatientDetailView"
      },
      {
        "id": "patients.create.open",
        "title": "Nuevo Paciente",
        "component": "./dist/views/patient-form/index.js",
        "export": "PatientFormView"
      },
      {
        "id": "patients.owners.open",
        "title": "Dueños",
        "component": "./dist/views/owners-list/index.js",
        "export": "OwnersListView"
      },
      {
        "id": "patients.owner-detail.open",
        "title": "Ficha Dueño",
        "component": "./dist/views/owner-detail/index.js",
        "export": "OwnerDetailView"
      }
    ],
    "repositories": [
      {
        "module": "./dist/repositories/pet.repository.js",
        "export": "PetRepository",
        "prefix": "patients.pets"
      },
      {
        "module": "./dist/repositories/vet-owner.repository.js",
        "export": "VetOwnerRepository",
        "prefix": "patients.owners"
      }
    ],
    "settings": {
      "groups": [
        {
          "id": "patients",
          "label": "Pacientes",
          "order": 50
        }
      ],
      "pages": [
        {
          "id": "patients.general",
          "group": "patients",
          "label": "General",
          "icon": "assets/icons/general.svg",
          "order": 10
        },
        {
          "id": "patients.registro",
          "group": "patients",
          "label": "Registro",
          "icon": "assets/icons/campos.svg",
          "order": 20
        }
      ],
      "sections": [
        {
          "id": "patients.general.species",
          "page": "patients.general",
          "label": "Especies habilitadas",
          "order": 5,
          "items": [
            {
              "key": "patients.species.dog",
              "type": "boolean",
              "label": "Perro",
              "description": "Habilitar especie Perro",
              "default": true,
              "tags": [
                "pacientes",
                "especie",
                "perro"
              ]
            },
            {
              "key": "patients.species.cat",
              "type": "boolean",
              "label": "Gato",
              "description": "Habilitar especie Gato",
              "default": true,
              "tags": [
                "pacientes",
                "especie",
                "gato"
              ]
            },
            {
              "key": "patients.species.bird",
              "type": "boolean",
              "label": "Ave",
              "description": "Habilitar especie Ave",
              "default": false,
              "tags": [
                "pacientes",
                "especie",
                "ave"
              ]
            },
            {
              "key": "patients.species.reptile",
              "type": "boolean",
              "label": "Reptil",
              "description": "Habilitar especie Reptil",
              "default": false,
              "tags": [
                "pacientes",
                "especie",
                "reptil"
              ]
            },
            {
              "key": "patients.species.rodent",
              "type": "boolean",
              "label": "Roedor",
              "description": "Habilitar especie Roedor",
              "default": false,
              "tags": [
                "pacientes",
                "especie",
                "roedor"
              ]
            },
            {
              "key": "patients.species.other",
              "type": "boolean",
              "label": "Otro",
              "description": "Habilitar especie Otro (exóticos, etc.)",
              "default": true,
              "tags": [
                "pacientes",
                "especie",
                "otro",
                "exótico"
              ]
            }
          ]
        },
        {
          "id": "patients.general.behavior",
          "page": "patients.general",
          "label": "Comportamiento",
          "order": 10,
          "items": [
            {
              "key": "patients.defaults.species",
              "type": "enum",
              "label": "Especie por defecto",
              "description": "Especie preseleccionada al crear un paciente",
              "default": "Perro",
              "options": [
                {
                  "value": "Perro",
                  "icon": "Dog"
                },
                {
                  "value": "Gato",
                  "icon": "Cat"
                },
                {
                  "value": "Ave",
                  "icon": "Bird"
                },
                {
                  "value": "Reptil",
                  "icon": "Turtle"
                },
                {
                  "value": "Roedor",
                  "icon": "Rabbit"
                },
                {
                  "value": "Otro",
                  "icon": "PawPrint"
                }
              ],
              "tags": [
                "pacientes",
                "especie",
                "defecto"
              ]
            },
            {
              "key": "patients.behavior.openDetailOnCreate",
              "type": "boolean",
              "label": "Abrir ficha al crear",
              "description": "Al crear un paciente, abrir automáticamente su ficha de detalle",
              "default": true,
              "tags": [
                "pacientes",
                "abrir",
                "ficha",
                "crear",
                "detalle"
              ]
            },
            {
              "key": "patients.behavior.hideDeceased",
              "type": "boolean",
              "label": "Ocultar pacientes fallecidos",
              "description": "Excluir pacientes fallecidos de la búsqueda y listado por defecto",
              "default": true,
              "tags": [
                "pacientes",
                "ocultar",
                "fallecidos",
                "muertos",
                "busqueda"
              ]
            },
            {
              "key": "patients.behavior.showCompleteness",
              "type": "boolean",
              "label": "Indicador de completitud",
              "description": "Mostrar qué porcentaje del perfil del paciente está completo",
              "default": false,
              "tags": [
                "pacientes",
                "completitud",
                "perfil",
                "porcentaje",
                "completo"
              ]
            }
          ]
        },
        {
          "id": "patients.registro.required",
          "page": "patients.registro",
          "label": "Campos obligatorios",
          "order": 10,
          "items": [
            {
              "key": "patients.required.sex",
              "type": "boolean",
              "label": "Sexo obligatorio",
              "description": "Requerir sexo al crear o editar un paciente",
              "default": false,
              "tags": [
                "pacientes",
                "obligatorio",
                "sexo",
                "requerir"
              ]
            },
            {
              "key": "patients.required.birthDate",
              "type": "boolean",
              "label": "Fecha de nacimiento obligatoria",
              "description": "Requerir fecha de nacimiento al crear o editar un paciente",
              "default": false,
              "tags": [
                "pacientes",
                "obligatorio",
                "fecha",
                "nacimiento",
                "requerir"
              ]
            },
            {
              "key": "patients.required.microchip",
              "type": "boolean",
              "label": "Microchip obligatorio",
              "description": "Requerir número de microchip al crear o editar un paciente",
              "default": false,
              "tags": [
                "pacientes",
                "obligatorio",
                "microchip",
                "requerir"
              ]
            }
          ]
        }
      ]
    }
  }
}
