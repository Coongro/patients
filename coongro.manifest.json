{
  "id": "patients",
  "version": "0.2.0",
  "apiVersion": "2.0",
  "assets": {
    "styles": [
      "./dist/assets/tailwind.css",
      "./dist/assets/fontawesome/css/all.min.css"
    ]
  },
  "contributes": {
    "menus": [
      {
        "path": "Pacientes",
        "order": 1,
        "color": "#10B981",
        "icon": "assets/icons/paw.svg"
      },
      {
        "path": "Pacientes/Mascotas",
        "order": 1,
        "viewId": "patients.list.open"
      },
      {
        "path": "Pacientes/Dueños",
        "order": 2,
        "viewId": "patients.owners.open"
      }
    ],
    "views": [
      {
        "id": "patients.list.open",
        "title": "Pacientes",
        "component": "./dist/views/patients-list/index.js",
        "export": "PatientsListView"
      },
      {
        "id": "patients.detail.open",
        "title": "Ficha Paciente",
        "component": "./dist/views/patient-detail/index.js",
        "export": "PatientDetailView"
      },
      {
        "id": "patients.create.open",
        "title": "Nuevo Paciente",
        "component": "./dist/views/patient-form/index.js",
        "export": "PatientFormView"
      },
      {
        "id": "patients.owners.open",
        "title": "Dueños",
        "component": "./dist/views/owners-list/index.js",
        "export": "OwnersListView"
      },
      {
        "id": "patients.owner-detail.open",
        "title": "Ficha Dueño",
        "component": "./dist/views/owner-detail/index.js",
        "export": "OwnerDetailView"
      }
    ],
    "repositories": [
      {
        "module": "./dist/repositories/pet.repository.js",
        "export": "PetRepository",
        "prefix": "patients.pets"
      },
      {
        "module": "./dist/repositories/vet-owner.repository.js",
        "export": "VetOwnerRepository",
        "prefix": "patients.owners"
      }
    ],
